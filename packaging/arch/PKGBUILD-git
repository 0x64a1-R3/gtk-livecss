pkgname=gtk-livecss-git
pkgver=1.0.2.r0.g0000000
pkgrel=1
pkgdesc="Universal LD_PRELOAD CSS hot-reloader for GTK3, GTK4, and Libadwaita"
arch=('x86_64' 'aarch64')
url="https://github.com/0x64a1-R3/gtk-livecss"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cmake' 'git')
provides=('gtk-livecss')
conflicts=('gtk-livecss')
install="gtk-livecss.install"
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    git describe --long --tags --abbrev=7 --exclude='latest' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cmake -B build -S "$pkgname" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$pkgname/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}